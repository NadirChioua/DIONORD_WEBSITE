# Copier ce fichier en .env.local et remplir les valeurs

# Email SMTP – pour recevoir les demandes de contact
# Exemple Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
# Créer un mot de passe d'application Google : https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre@gmail.com
SMTP_PASS=votre_mot_de_passe_application

# Email destinataire des demandes de contact
CONTACT_EMAIL=contact@dionord.com

# Domaine canonique du site (Search Console)
NEXT_PUBLIC_SITE_URL=https://www.dionord.com
# Optionnel : code de vérification Google Search Console (balise meta)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 (ID de mesure, ex. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Mot de passe de la page /admin (obligatoire, aucun mot de passe par défaut)
ADMIN_PASSWORD=

# Base de données (demandes, statistiques, contenu, images)
# Créées automatiquement par Vercel → Storage → Upstash for Redis → Connect Project
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optionnel : données Google Search Console dans /admin (compte de service Google en lecture seule)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# ID numérique de la propriété GA4 (Admin → Paramètres de la propriété)
GA4_PROPERTY_ID=
GSC_SITE_URL=sc-domain:dionord.com
